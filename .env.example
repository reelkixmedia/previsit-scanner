# Previsit Scanner - example settings. Copy to .env (never commit .env).
# FAKE / SYNTHETIC DATA ONLY. This is a demo, not a certified HIPAA system.

# Where the SQLite DB, dev master key and audit.jsonl are written (default: ./instance)
PREVISIT_INSTANCE_DIR=instance

# Fernet master key that wraps each practice's data key.
# Leave blank for local demos: a dev key is generated at runtime in <instance>/master.key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PREVISIT_MASTER_KEY=

# Database (default: SQLite in the instance folder)
# PREVISIT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/previsit

# Outreach safety: 1 = dry run (nothing is emailed). Keep 1 for demos.
PREVISIT_DRY_RUN=1
# If set, real sends only go to these addresses (comma separated)
PREVISIT_EMAIL_ALLOWLIST=

# Set to 1 when served behind HTTPS
PREVISIT_SECURE_COOKIES=0
PREVISIT_SESSION_IDLE_MINUTES=15
# Daily in-process scan loop (run in one process only)
PREVISIT_SCHEDULER=1

# Optional Microsoft / Google sign-in (OIDC). Off unless both values are set.
PREVISIT_BASE_URL=http://localhost:8791
PREVISIT_MICROSOFT_CLIENT_ID=
PREVISIT_MICROSOFT_CLIENT_SECRET=
PREVISIT_GOOGLE_CLIENT_ID=
PREVISIT_GOOGLE_CLIENT_SECRET=
